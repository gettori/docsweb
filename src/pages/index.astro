---
import Base from "../components/home/Base.astro";
import Nav from "../components/home/Nav.astro";
import Hero from "../components/home/Hero.astro";
import Marquee from "../components/home/Marquee.astro";
import Scatter from "../components/home/Scatter.astro";
import Bento from "../components/home/Bento.astro";
import Closing from "../components/home/Closing.astro";
import Footer from "../components/home/Footer.astro";
import ToTop from "../components/home/ToTop.astro";
import SixPlaces from "../islands/SixPlaces";
import Story from "../islands/Story";
import CaptainGame from "../islands/CaptainGame";
import Spaces from "../islands/Spaces";
import Autopilot from "../islands/Autopilot";
---

<Base>
  <Nav />
  <main>
    <Hero />
    <Marquee />
    <Scatter />
    <section class="section">
      <SixPlaces client:visible />
    </section>
    <div class="story-slot" data-story>
      <Story client:only="solid-js" />
    </div>
    <section class="section">
      <CaptainGame client:visible />
    </section>
    <section class="section">
      <Spaces client:visible />
    </section>
    <section class="section">
      <Autopilot client:only="solid-js" />
    </section>
    <Bento />
    <Closing />
  </main>
  <Footer />
  <ToTop />
</Base>

<script>
  import "../components/home/smoothScroll";
</script>

<style>
  .story-slot {
    position: relative;
    height: 440vh;
  }
</style>
