---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource-variable/inter";
import "@fontsource/instrument-serif/400-italic.css";
import "../styles/site.css";
import Trailer from "../islands/Trailer";

// A dynamic route with no paths in production, so /trailer only exists under `astro dev`.
export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { trailer: "trailer" } }] : [];
}
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Tori trailer</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <Trailer client:only="solid-js" />
  </body>
</html>

<style is:global>
  astro-dev-toolbar {
    display: none !important;
  }
</style>
