---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  mobile?: boolean;
}

const { headings, mobile } = Astro.props;
const items = [{ depth: 2, slug: "_top", text: "Overview" }, ...headings.filter((h) => h.depth === 2 || h.depth === 3)];
---

{
  mobile ? (
    <details class="mobile" data-toc-mobile data-pagefind-ignore>
      <summary>
        <span class="label">On this page</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="m9 6 6 6-6 6" />
        </svg>
        <span class="now" data-toc-now>Overview</span>
      </summary>
      <ul>
        {items.map((h) => (
          <li data-depth={h.depth}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </details>
  ) : (
    <nav class="toc" aria-labelledby="toc-title">
      <h2 id="toc-title">On this page</h2>
      <ul>
        {items.map((h) => (
          <li data-depth={h.depth}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  // Marks the heading being read. Rebuilt on every page swap, since the list
  // and the headings it watches are both new.
  let stop: (() => void) | null = null;
  const track = () => {
    stop?.();
    const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a, [data-toc-mobile] a")];
    if (!links.length) return;
    const ids = [...new Set(links.map((a) => a.hash.slice(1)))];
    const heads = ids.map((id) => document.getElementById(id)).filter((h): h is HTMLElement => !!h);
    const now = document.querySelector<HTMLElement>("[data-toc-now]");
    const pick = () => {
      const line = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 80;
      let at = heads[0];
      for (const h of heads) if (h.getBoundingClientRect().top <= line + 1) at = h;
      for (const a of links) a.toggleAttribute("aria-current", a.hash === `#${at?.id}`);
      if (now && at) now.textContent = links.find((a) => a.hash === `#${at.id}`)?.textContent ?? "";
    };
    let raf = 0;
    const onScroll = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(pick);
    };
    addEventListener("scroll", onScroll, { passive: true });
    pick();
    const mobile = document.querySelector<HTMLDetailsElement>("[data-toc-mobile]");
    const close = (e: Event) => (e.target as HTMLElement).closest("a") && mobile && (mobile.open = false);
    mobile?.addEventListener("click", close);
    stop = () => {
      removeEventListener("scroll", onScroll);
      mobile?.removeEventListener("click", close);
    };
  };
  document.addEventListener("astro:page-load", track);
</script>

<style>
  h2 {
    margin: 0 0 0.5rem;
    color: var(--d-strong);
    font-size: 16px;
    font-weight: 600;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li[data-depth="3"] {
    padding-left: 1rem;
  }
  a {
    display: block;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    color: var(--d-muted);
    font-size: 13px;
    line-height: 1.5;
    text-decoration: none;
    transition: color 0.15s;
  }
  a:hover {
    color: var(--d-strong);
  }
  a[aria-current] {
    color: var(--d-accent-high);
  }
  .mobile {
    position: sticky;
    top: var(--d-nav-h);
    z-index: 5;
    margin: 0 calc(-1 * clamp(1rem, 3vw, 3rem));
    border-bottom: 1px solid var(--tori-hair);
    background: color-mix(in srgb, var(--d-nav) 88%, transparent);
    backdrop-filter: blur(12px);
  }
  .mobile summary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0.6rem clamp(1rem, 3vw, 3rem);
    list-style: none;
    font-size: 13px;
    cursor: pointer;
  }
  .mobile summary::-webkit-details-marker {
    display: none;
  }
  .label {
    padding: 2px 10px;
    border: 1px solid var(--d-line);
    border-radius: 8px;
    color: var(--d-strong);
  }
  .mobile summary svg {
    color: var(--d-muted);
    transition: transform 0.2s;
  }
  .mobile[open] summary svg {
    transform: rotate(90deg);
  }
  .now {
    overflow: hidden;
    color: var(--d-text);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .mobile ul {
    max-height: 60vh;
    overflow-y: auto;
    padding: 0 clamp(1rem, 3vw, 3rem) 0.75rem;
  }
  @media (min-width: 72.01rem) {
    .mobile {
      display: none;
    }
  }
</style>
