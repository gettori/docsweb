---
const { entry, sidebar } = Astro.locals.starlightRoute;
const { title, description } = entry.data;

type Entry = (typeof sidebar)[number];
const hasCurrent = (e: Entry): boolean => (e.type === "link" ? e.isCurrent : e.entries.some(hasCurrent));
const group = sidebar.find((e) => e.type === "group" && hasCurrent(e))?.label ?? "Tori docs";

const cut = title.lastIndexOf(" ");
const lead = cut > 0 ? title.slice(0, cut + 1) : "";
const last = cut > 0 ? title.slice(cut + 1) : title;
---

<div class="title">
  <div class="dots" aria-hidden="true"></div>
  <span class="eyebrow"><i></i>{group}</span>
  <h1 id="_top">{lead}{lead ? <span class="accent-word">{last}</span> : last}</h1>
  {description && <p class="lede">{description}</p>}
</div>

<style>
  .title {
    position: relative;
    isolation: isolate;
    padding: clamp(1.5rem, 4vw, 3rem) 0 0.5rem;
  }
  .dots {
    position: absolute;
    inset: -2rem -40vw -1rem -3rem;
    z-index: -1;
    pointer-events: none;
    background-image: radial-gradient(var(--tori-dot) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: radial-gradient(45% 70% at 25% 40%, #000, transparent);
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px 4px 8px;
    border-radius: 99px;
    background: var(--tori-glass);
    box-shadow: inset 0 0 0 1px var(--tori-hair);
    font-family: var(--sl-font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .eyebrow i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sl-color-accent);
    box-shadow: 0 0 10px var(--sl-color-accent);
    animation: blink 2.4s ease-in-out infinite;
  }
  h1 {
    margin: 14px 0 0;
    font-size: clamp(38px, 5.4vw, 64px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 700;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .lede {
    max-width: 34em;
    margin: 18px 0 0;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
  .accent-word {
    font-family: "Instrument Serif", Georgia, serif;
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.02em;
    padding-inline-end: 0.06em;
    color: var(--sl-color-accent);
  }
  @keyframes blink {
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .eyebrow i {
      animation: none;
    }
  }
</style>
