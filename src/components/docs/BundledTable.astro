---
import { getCollection } from "astro:content";
import { byTab, kindName } from "../../packs/view";

const packs = (await getCollection("packs"))
  .map((e) => e.data)
  .filter((p) => p.bundled)
  .sort(byTab);
---

<table>
  <thead>
    <tr><th>Kind</th><th>Pack</th><th>Id</th></tr>
  </thead>
  <tbody>
    {
      packs.map((p) => (
        <tr>
          <td>{kindName(p)}</td>
          <td>
            <a href={`/packs/${p.kind}/${p.id}/`}>{p.label}</a>
          </td>
          <td>
            <code>{p.id}</code>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
