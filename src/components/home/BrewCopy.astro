---
import { SITE } from "../../config";

interface Props {
  tone?: "glass" | "night";
}
const { tone = "glass" } = Astro.props;
---

<div class:list={["brew", tone]} data-brew>
  <span class="dollar">$</span>
  <span class="cmd">{SITE.brew}</span>
  <button type="button" data-copy={SITE.brew}>Copy</button>
</div>

<style>
  .brew {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 52px;
    max-width: 100%;
    padding: 0 8px 0 20px;
    border-radius: 999px;
    background: var(--glass);
    border: 1px solid var(--line);
    backdrop-filter: blur(10px);
    font-family: var(--mono);
    font-size: 13.5px;
    color: var(--soft);
    overflow: hidden;
    position: relative;
    transition: box-shadow 0.6s;
  }
  .brew.night {
    color-scheme: dark;
    height: 54px;
    background: rgba(10, 8, 24, 0.45);
    border-color: rgba(216, 180, 254, 0.22);
    color: #f5efff;
  }
  .dollar {
    color: var(--faint);
  }
  .night .dollar {
    color: #cbc3e3;
  }
  .cmd {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  button {
    flex: none;
    height: 38px;
    padding: 0 14px;
    border: none;
    border-radius: 999px;
    background: var(--glass-hi);
    color: var(--text);
    font: 500 13px var(--sans);
    cursor: pointer;
    transition: background 0.2s;
  }
  button:hover {
    background: light-dark(rgba(20, 22, 30, 0.13), rgba(255, 255, 255, 0.14));
  }
  .night button {
    height: 40px;
    background: rgba(216, 180, 254, 0.14);
  }
  :global([data-theme="light"]) .brew.night {
    color-scheme: light;
    background: var(--glass);
    border-color: var(--line);
    color: var(--soft);
  }
  :global([data-theme="light"]) .night .dollar {
    color: var(--faint);
  }
  :global([data-theme="light"]) .night button {
    background: var(--glass-hi);
  }

  .brew.glow {
    box-shadow:
      0 0 0 1px var(--accent-text),
      0 0 36px rgba(217, 164, 104, 0.4);
    animation: brew-glow 1.2s ease-in-out 3;
  }
  .brew.glow::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 30%, rgba(255, 236, 205, 0.3) 50%, transparent 70%);
    transform: translateX(-100%);
    animation: brew-sweep 1.1s var(--ease) 0.15s;
    pointer-events: none;
  }
  .brew.glow button {
    background: var(--accent);
    color: var(--on-accent);
  }
  .brew.glow button:hover {
    background: #f8dfb8;
  }
  @keyframes brew-glow {
    50% {
      box-shadow:
        0 0 0 3px var(--accent-text),
        0 0 70px 6px rgba(217, 164, 104, 0.6);
    }
  }
  @keyframes brew-sweep {
    to {
      transform: translateX(100%);
    }
  }
</style>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
    btn.addEventListener("click", () => {
      navigator.clipboard?.writeText(btn.dataset.copy ?? "").catch(() => {});
      btn.closest("[data-brew]")?.classList.remove("glow");
      btn.textContent = "Copied";
      setTimeout(() => (btn.textContent = "Copy"), 1600);
    });
  }
</script>
