---
import { SITE } from "../../config";

interface Props {
  id: string;
  tone?: "glass" | "night";
}
const { id, tone = "glass" } = Astro.props;
---

<p class:list={["note", tone]} id={id} data-install-note>
  <span class="line" data-step="1">Nope. It's unsigned for now, so macOS would say the DMG is damaged. Brew skips all that.</span>
  <span class="line" data-step="2">Still nope. One paste of the brew line and you're in.</span>
  <span class="line" data-step="3">Stubborn, huh? Fine, <a href="/docs/install/#install-from-the-dmg">here are the DMG steps</a>.</span>
  <a href={SITE.android} class="apk">
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><path
        d="M18.4395 5.5586c-.675 1.1664-1.352 2.3318-2.0274 3.498-.0366-.0155-.0742-.0286-.1113-.043-1.8249-.6957-3.484-.8-4.42-.787-1.8551.0185-3.3544.4643-4.2597.8203-.084-.1494-1.7526-3.021-2.0215-3.4864a1.1451 1.1451 0 0 0-.1406-.1914c-.3312-.364-.9054-.4859-1.379-.203-.475.282-.7136.9361-.3886 1.5019 1.9466 3.3696-.0966-.2158 1.9473 3.3593.0172.031-.4946.2642-1.3926 1.0177C2.8987 12.176.452 14.772 0 18.9902h24c-.119-1.1108-.3686-2.099-.7461-3.0683-.7438-1.9118-1.8435-3.2928-2.7402-4.1836a12.1048 12.1048 0 0 0-2.1309-1.6875c.6594-1.122 1.312-2.2559 1.9649-3.3848.2077-.3615.1886-.7956-.0079-1.1191a1.1001 1.1001 0 0 0-.8515-.5332c-.5225-.0536-.9392.3128-1.0488.5449zm-.0391 8.461c.3944.5926.324 1.3306-.1563 1.6503-.4799.3197-1.188.0985-1.582-.4941-.3944-.5927-.324-1.3307.1563-1.6504.4727-.315 1.1812-.1086 1.582.4941zM7.207 13.5273c.4803.3197.5506 1.0577.1563 1.6504-.394.5926-1.1038.8138-1.584.4941-.48-.3197-.5503-1.0577-.1563-1.6504.4008-.6021 1.1087-.8106 1.584-.4941z"
      ></path></svg
    >Android APK
  </a>
</p>

<style>
  .note {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 14px;
    max-width: min(100%, 720px);
    margin: 20px 0 0;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--muted);
  }
  .night {
    color: #cbc3e3;
  }
  :global([data-theme="light"]) .night {
    color: var(--muted);
  }
  :global(:root[data-nope]) .note {
    display: flex;
  }
  .line {
    display: none;
    text-wrap: balance;
    animation: v-rise 0.5s var(--ease) both;
  }
  :global(:root[data-nope="1"]) .line[data-step="1"],
  :global(:root[data-nope="2"]) .line[data-step="2"],
  :global(:root[data-nope="3"]) .line[data-step="3"] {
    display: block;
  }
  .line a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .apk {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 30px;
    padding: 0 12px 0 10px;
    border-radius: 999px;
    background: var(--glass);
    border: 1px solid var(--line);
    color: var(--text);
    font-weight: 500;
    font-size: 13px;
    white-space: nowrap;
    transition: background 0.2s;
    animation: v-rise 0.5s var(--ease) 0.12s both;
  }
  .apk:hover {
    background: var(--glass-hi);
    color: var(--text);
  }
  .apk svg {
    width: 15px;
    height: 15px;
    fill: #3ddc84;
  }

  :global(:root[data-nope] [data-download]),
  :global(:root[data-nope] [data-download]:hover) {
    filter: grayscale(1);
    opacity: 0.45;
    box-shadow: none;
    transform: none;
    transition:
      filter 0.5s,
      opacity 0.5s,
      box-shadow 0.5s;
  }
</style>

<script>
  import { lenis } from "./smoothScroll";

  // The app is unsigned, so a downloaded DMG opens as "damaged". Download says no and points at the brew line instead.
  const root = document.documentElement;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const brews = [...document.querySelectorAll<HTMLElement>("[data-brew]")];
  const SHAKE = [0, -14, 11, -8, 5, -2, 0].map((d) => ({
    transform: `perspective(300px) translateX(${d / 2}px) rotateY(${d * 1.5}deg)`,
  }));
  let step = 0;

  const offCenter = (el: HTMLElement) => {
    const r = el.getBoundingClientRect();
    return Math.abs(r.top + r.height / 2 - innerHeight / 2);
  };

  const glow = (brew: HTMLElement) => {
    brew.classList.remove("glow");
    void brew.offsetWidth;
    brew.classList.add("glow");
    const note = brew.closest("[data-install]")!.querySelector("[data-install-note]")!;
    const copy = brew.querySelector("button")!;
    copy.setAttribute("aria-describedby", note.id);
    copy.focus({ preventScroll: true });
  };

  for (const btn of document.querySelectorAll<HTMLElement>("[data-download]")) {
    btn.addEventListener("click", (ev) => {
      ev.preventDefault();
      step = Math.min(step + 1, 3);
      root.dataset.nope = String(step);
      if (!reduced) btn.animate(SHAKE, { duration: 620, easing: "ease-out" });

      // The nav button sits in no section, so it points at whichever brew line is closest.
      const brew =
        btn.closest("[data-install]")?.querySelector<HTMLElement>("[data-brew]") ??
        brews.reduce((a, b) => (offCenter(b) < offCenter(a) ? b : a));
      const r = brew.getBoundingClientRect();
      if (r.top > 80 && r.bottom < innerHeight) return glow(brew);
      if (lenis) {
        lenis.scrollTo(brew, { offset: (r.height - innerHeight) / 2, duration: 1.4, onComplete: () => glow(brew) });
      } else {
        brew.scrollIntoView({ block: "center" });
        glow(brew);
      }
    });
  }
</script>
