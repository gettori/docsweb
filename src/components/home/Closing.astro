---
import BrewCopy from "./BrewCopy.astro";
import { SITE } from "../../config";

let seed = 11;
const rnd = () => (seed = (seed * 9301 + 49297) % 233280) / 233280;
const stars = Array.from({ length: 50 }, () => ({
  x: (rnd() * 100).toFixed(2),
  y: (rnd() * 60).toFixed(2),
  r: rnd() > 0.85 ? 2 : 1.2,
  d: (2.5 + rnd() * 4).toFixed(1),
  dl: (rnd() * 5).toFixed(1),
}));

// Light mode's stars. [left vw, top %, width px, opacity, seconds per crossing]; bigger and nearer the sea lower down.
const CLOUDS: [number, number, number, number, number][] = [
  [14, 14, 140, 0.8, 170],
  [72, 10, 100, 0.7, 190],
  [9, 46, 210, 0.85, 140],
  [84, 38, 180, 0.85, 150],
  [52, 62, 260, 1, 120],
];
const clouds = CLOUDS.map(([x, top, w, op, dur]) => ({
  style: `--x:${x};top:${top}%;width:${w}px;opacity:${op};animation-duration:${dur}s;animation-delay:-${(((x + 25) / 135) * dur).toFixed(1)}s`,
}));
---

<section class="closing" data-closing>
  <div class="stars" aria-hidden="true">
    {stars.map((s) => <span style={`left:${s.x}%;top:${s.y}%;width:${s.r}px;height:${s.r}px;animation-duration:${s.d}s;animation-delay:-${s.dl}s`} />)}
  </div>
  <div class="clouds" aria-hidden="true">
    {
      clouds.map((c) => (
        <svg class="cloud" viewBox="-36 -26 72 36" style={c.style}>
          <ellipse cx="0" cy="0" rx="34" ry="9" />
          <circle cx="-12" cy="-6" r="11" />
          <circle cx="6" cy="-10" r="14" />
          <circle cx="22" cy="-3" r="9" />
        </svg>
      ))
    }
  </div>
  <div class="inner">
    <img src="/app-icon.png" alt="" class="icon" width="84" height="84" />
    <h2>Your crew is <span class="accent-word gold">waiting.</span></h2>
    <p>A cockpit for the coding agents you already run.</p>
    <div class="ctas">
      <a href={SITE.download} class="primary" aria-label="Download for macOS">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path
            d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9-.1 0-2.7-1-2.7-4.1zM13.9 5c.7-.9 1.2-2 1-3.2-1 0-2.3.7-3 1.6-.7.8-1.2 2-1.1 3.1 1.2.1 2.3-.6 3.1-1.5z"
          ></path></svg
        >Download
      </a>
      <BrewCopy tone="night" />
    </div>
  </div>
  <div class="sea" aria-hidden="true">
    <div class="scene" data-scene></div>
  </div>
</section>

<style>
  .closing {
    --sky-top: #0a0816;
    --sky-mid: #0d0b1d;
    position: relative;
    margin-top: 40px;
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    background: linear-gradient(180deg, var(--page) 0%, var(--sky-top) 35%, var(--sky-mid) 100%);
  }
  :global([data-theme="light"]) .closing {
    background: linear-gradient(180deg, var(--page) 15%, color-mix(in oklch, var(--sky-mid), var(--page) 80%) 100%);
  }
  .clouds {
    display: none;
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  :global([data-theme="light"]) .clouds {
    display: block;
  }
  .cloud {
    position: absolute;
    left: calc(var(--x) * 1vw);
    height: auto;
    fill: color-mix(in oklch, var(--sky-mid), #fff 95%);
    filter: drop-shadow(0 8px 14px color-mix(in oklch, var(--sky-mid) 14%, transparent));
    animation: cloud-drift linear infinite;
  }
  /* Starts left of the viewport and ends past it; the negative delay puts each cloud at its left: position at load. */
  @keyframes cloud-drift {
    from {
      transform: translateX(calc((var(--x) + 25) * -1vw));
    }
    to {
      transform: translateX(calc((110 - var(--x)) * 1vw));
    }
  }
  :global([data-theme="light"]) .stars {
    display: none;
  }
  :global([data-theme="light"]) .icon {
    filter: none;
  }
  :global([data-theme="light"]) h2 {
    color: var(--strong);
  }
  :global([data-theme="light"]) .gold {
    color: var(--accent-text);
  }
  :global([data-theme="light"]) p {
    color: var(--muted);
  }
  :global([data-theme="light"]) .scene {
    mask-image: linear-gradient(180deg, transparent, #000 80%);
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 80%);
  }
  .stars {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .stars span {
    position: absolute;
    border-radius: 50%;
    background: #fff;
    opacity: 0.7;
    animation: v-breathe ease-in-out infinite;
  }
  .inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 120px var(--pad-x) 60px;
  }
  .icon {
    filter: drop-shadow(0 0 40px rgba(217, 164, 104, 0.6));
    animation: v-drift 5s ease-in-out infinite;
  }
  h2 {
    margin: 30px 0 0;
    max-width: 12ch;
    font-size: clamp(46px, 8vw, 120px);
    line-height: 0.95;
    letter-spacing: -0.055em;
    font-weight: 700;
    color: #fff;
  }
  .gold {
    color: var(--accent);
  }
  p {
    margin: 22px 0 0;
    font-size: 18px;
    color: #cbc3e3;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 34px;
    max-width: 100%;
  }
  .primary {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 54px;
    padding: 0 24px;
    border-radius: 999px;
    background: linear-gradient(180deg, #f8dfb8, #e2b378);
    color: var(--on-accent);
    font-weight: 600;
    font-size: 16px;
    box-shadow:
      0 10px 50px rgba(217, 164, 104, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }
  .primary:hover {
    color: var(--on-accent);
  }
  .sea {
    position: relative;
    width: 100%;
    aspect-ratio: 1200 / 176;
    min-height: 130px;
    margin-top: auto;
  }
  /* The scene's translucent wave layers show through the antialiased bottom row as a line above the footer. */
  .sea::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--page);
  }
  .scene {
    --canvas-default: var(--page);
    position: absolute;
    inset: 0;
    mask-image: linear-gradient(180deg, transparent, #000 45%);
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 45%);
  }
  .scene :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  // Same hour ranges as the app's cockpit banner (Horizon.tsx pickScene).
  const h = new Date().getHours();
  const scene =
    h >= 5 && h < 8 ? "dawn" : h < 11 && h >= 8 ? "morning" : h >= 11 && h < 15 ? "midday" : h >= 15 && h < 18 ? "golden" : h >= 18 && h < 21 ? "dusk" : "night";
  // The second colour is each scene SVG's top sky stop, so the section runs into it without a seam.
  const SKY: Record<string, [string, string]> = {
    dawn: ["#15102c", "#231c47"],
    morning: ["#171239", "#2c2266"],
    midday: ["#15143e", "#28276e"],
    golden: ["#1d1436", "#3a2868"],
    dusk: ["#110d24", "#191433"],
    night: ["#0a0816", "#0d0b1d"],
  };
  const sec = document.querySelector<HTMLElement>("[data-closing]")!;
  sec.style.setProperty("--sky-top", SKY[scene][0]);
  sec.style.setProperty("--sky-mid", SKY[scene][1]);
  const slot = sec.querySelector<HTMLElement>("[data-scene]")!;
  new IntersectionObserver((entries, io) => {
    if (!entries[0].isIntersecting) return;
    io.disconnect();
    fetch(`/scenes/${scene}.svg`)
      .then((r) => r.text())
      .then((svg) => (slot.innerHTML = svg))
      .catch(() => {});
  }, { rootMargin: "400px" }).observe(sec);
</script>
