<button type="button" class="helm" data-helm aria-label="Back to port, scroll to the top">
  <span class="label"><span>Back to port</span></span>
  <span class="dial">
    <svg class="ring" viewBox="0 0 48 48" fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="helm-gold" x1="0" y1="0" x2="1" y2="1">
          <stop class="gold-a" offset="0"></stop>
          <stop class="gold-b" offset="1"></stop>
        </linearGradient>
      </defs>
      <circle class="track" cx="24" cy="24" r="19.5"></circle>
      <circle class="sailed" cx="24" cy="24" r="19.5" pathLength="1" stroke="url(#helm-gold)"></circle>
      <circle class="glint" cx="24" cy="24" r="19.5" pathLength="1"></circle>
    </svg>
    <span class="grip">
      <svg class="wheel" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="6.6"></circle>
        <circle cx="12" cy="12" r="1.7" fill="currentColor" stroke="none"></circle>
        <path d="M14.6 12H22.2M13.84 13.84L19.21 19.21M12 14.6V22.2M10.16 13.84L4.79 19.21M9.4 12H1.8M10.16 10.16L4.79 4.79M12 9.4V1.8M13.84 10.16L19.21 4.79"></path>
      </svg>
    </span>
  </span>
</button>

<style>
  .helm {
    --p: 0;
    --turn: 0;
    --lift: 0;
    --tint: light-dark(rgba(255, 255, 255, 0.34), rgba(34, 38, 50, 0.38));
    --sheen: light-dark(rgba(255, 255, 255, 0.75), rgba(255, 255, 255, 0.16));
    --edge: light-dark(rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.2));
    --under: light-dark(rgba(60, 50, 90, 0.1), rgba(0, 0, 0, 0.35));
    position: fixed;
    right: clamp(14px, 2.4vw, 28px);
    bottom: calc(clamp(14px, 2.4vw, 28px) + var(--lift) * 1px);
    z-index: 40;
    display: flex;
    align-items: center;
    padding: 0;
    border: 1px solid light-dark(rgba(20, 22, 30, 0.08), rgba(255, 255, 255, 0.1));
    border-radius: 999px;
    background:
      radial-gradient(120% 90% at 30% 0%, var(--sheen), transparent 60%),
      var(--tint);
    backdrop-filter: blur(22px) saturate(1.9) brightness(1.06);
    -webkit-backdrop-filter: blur(22px) saturate(1.9) brightness(1.06);
    box-shadow:
      inset 0 1px 0 var(--edge),
      inset 0 -1px 0 var(--under),
      inset 0 0 14px light-dark(rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.05)),
      0 14px 36px var(--shadow),
      0 2px 6px light-dark(rgba(40, 36, 70, 0.08), rgba(0, 0, 0, 0.3));
    color: var(--soft);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px) scale(0.86);
    transition:
      opacity 0.35s var(--ease),
      transform 0.45s var(--ease),
      visibility 0s 0.45s,
      color 0.2s;
  }
  .helm[data-shown] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .helm:hover,
  .helm:focus-visible {
    color: var(--accent-text);
  }
  .helm:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 3px;
  }
  .label {
    display: grid;
    grid-template-columns: 0fr;
    transition: grid-template-columns 0.45s var(--ease);
  }
  .label span {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .label span::before {
    content: "";
    display: inline-block;
    width: 18px;
  }
  .helm:hover .label,
  .helm:focus-visible .label {
    grid-template-columns: 1fr;
  }
  .helm:hover .label span,
  .helm:focus-visible .label span {
    opacity: 1;
  }
  .dial {
    position: relative;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
  }
  .ring {
    position: absolute;
    inset: 0;
    overflow: visible;
    transform: rotate(-90deg);
  }
  .track,
  .sailed {
    stroke-width: 3.5;
  }
  .track {
    stroke: light-dark(rgba(20, 22, 30, 0.07), rgba(255, 255, 255, 0.08));
  }
  .sailed {
    stroke-linecap: round;
    stroke-dasharray: var(--p) 1;
    stroke-opacity: light-dark(0.72, 0.5);
    filter: drop-shadow(0 0 5px light-dark(rgba(200, 130, 50, 0.45), rgba(243, 211, 164, 0.45)));
  }
  .glint {
    stroke: #fff;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-dasharray: var(--p) 1;
    stroke-opacity: light-dark(0.38, 0.45);
    filter: blur(0.6px);
  }
  .gold-a {
    stop-color: light-dark(#f0b25e, #fff1d9);
  }
  .gold-b {
    stop-color: light-dark(#c67a26, #e9b06a);
  }
  .grip {
    display: flex;
    transition: transform 0.6s var(--ease);
  }
  .helm:hover .grip,
  .helm:focus-visible .grip {
    transform: rotate(-45deg);
  }
  .helm:active .grip {
    transform: rotate(-90deg);
    transition-duration: 0.15s;
  }
  .wheel {
    width: 20px;
    height: 20px;
    transform: rotate(calc(var(--turn) * 1deg));
  }
</style>

<script>
  import { lenis } from "./smoothScroll";

  const helm = document.querySelector<HTMLButtonElement>("[data-helm]")!;
  const footer = document.querySelector("footer")!;
  const update = () => {
    const p = Math.max(0, Math.min(1, scrollY / Math.max(1, document.documentElement.scrollHeight - innerHeight)));
    helm.style.setProperty("--p", p.toFixed(4));
    if (lenis) helm.style.setProperty("--turn", (scrollY * 0.18).toFixed(1));
    helm.style.setProperty("--lift", Math.max(0, innerHeight - footer.getBoundingClientRect().top).toFixed(0));
    helm.toggleAttribute("data-shown", scrollY > innerHeight * 0.7);
  };
  addEventListener("scroll", update, { passive: true });
  addEventListener("resize", update);
  update();

  helm.addEventListener("click", () => {
    if (!lenis) return scrollTo(0, 0);
    const seconds = Math.min(2.6, 1.1 + scrollY / 9000);
    lenis.scrollTo(0, { duration: seconds, easing: (t) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2) });
  });
</script>
