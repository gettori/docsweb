---
import type { Pack } from "../../packs/catalog";
import { iconPath } from "../../packs/view";

interface Props {
  pack: Pack;
  size: "card" | "title";
}

const { pack, size } = Astro.props;
const icon = iconPath(pack);
---

<span class:list={["icon", size]} aria-hidden="true">
  {icon ? <span class="mask" style={`--icon: url(${icon})`} /> : pack.label.charAt(0).toUpperCase()}
</span>

<style>
  .icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--hair);
    font-weight: 600;
    color: var(--text);
  }
  .card {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: light-dark(#f6f5f2, #1b1e25);
    font-size: 16px;
  }
  .title {
    width: clamp(48px, 6vw, 64px);
    height: clamp(48px, 6vw, 64px);
    border-radius: 14px;
    background: var(--raised);
    font-size: clamp(20px, 2.4vw, 26px);
  }
  /* A mask, so the one-colour logo takes the text colour in both themes, the
     way Tori draws it, and the SVG never runs as a document. */
  .mask {
    width: 55%;
    height: 55%;
    background-color: currentColor;
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
  }
</style>
