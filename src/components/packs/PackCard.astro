---
import type { Pack } from "../../packs/catalog";
import AgentIcon from "./AgentIcon.astro";
import { PLATFORM_ICONS } from "../../packs/platformIcons";
import { PLATFORMS, chat, kindName, newerThanRelease, onMac, palette, shortDay, shortVersion, splitVerified, tabOf } from "../../packs/view";

interface Props {
  pack: Pack;
}

const { pack } = Astro.props;
const verified = pack.verified_against && pack.verified_on ? { ...splitVerified(pack.verified_against), day: shortDay(pack.verified_on) } : null;
---

<a class="card" href={`/packs/${pack.kind}/${pack.id}/`} data-pack data-kind={tabOf(pack)} data-name={`${pack.label} ${pack.id}`.toLowerCase()}>
  <div class="top">
    <span>{kindName(pack)}</span>
    <span class="chips">
      {pack.appearance && <span class="tone">{pack.appearance === "dark" ? "Dark" : "Light"}</span>}
      {pack.bundled && <span class="bundled">Bundled</span>}
    </span>
  </div>
  <div class="who">
    {pack.kind === "agents" && <AgentIcon pack={pack} size="card" />}
    <div>
      <div class="label">{pack.label}</div>
      <div class="by">by {pack.contributor.name}</div>
    </div>
  </div>
  {
    pack.kind === "themes" && (
      <div class="strip" aria-hidden="true">
        {palette(pack).map((s) => (
          <span style={`background: ${s.hex}`} />
        ))}
      </div>
    )
  }
  {pack.kind === "agents" && <span class="tier">{chat(pack).pill}</span>}
  <div class="end">
    {newerThanRelease(pack.min_tori) && <p class="newer">Needs Tori {shortVersion(pack.min_tori)} or newer</p>}
    {!onMac(pack) && <p class="na">Not available on macOS</p>}
    <div class="foot">
      <span class="marks">
        {
          PLATFORMS.filter((p) => pack.platforms.includes(p.key)).map((p) => (
            <span class="mark" title={p.name}>
              <svg viewBox={PLATFORM_ICONS[p.key].viewBox} aria-hidden="true">
                <path d={PLATFORM_ICONS[p.key].d} />
              </svg>
            </span>
          ))
        }
      </span>
      {
        verified && (
          <span class="verified" title={`Verified against ${pack.verified_against}`}>
            {verified.tool && <span class="tool">{verified.tool}</span>}
            <span class="keep">
              {verified.version} · {verified.day}
            </span>
          </span>
        )
      }
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 18px;
    border-radius: 12px;
    border: 1px solid var(--hair);
    background: var(--card);
    color: var(--text);
    transition: border-color 0.3s var(--ease);
  }
  .card:hover {
    color: var(--text);
    border-color: light-dark(rgba(20, 22, 30, 0.22), rgba(255, 255, 255, 0.18));
  }
  .card[hidden] {
    display: none;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 20px;
    font-size: 12.5px;
    color: var(--muted);
  }
  .chips {
    display: flex;
    gap: 6px;
  }
  .bundled,
  .tone {
    display: inline-flex;
    align-items: center;
    height: 20px;
    padding: 0 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent-text);
    font-size: 11.5px;
    font-weight: 500;
  }
  .tone {
    background: var(--glass-hi);
    color: var(--muted);
  }
  .who {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .label {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.012em;
  }
  .by {
    margin-top: 3px;
    font-size: 13px;
    color: var(--muted);
  }
  .strip {
    display: flex;
    height: 26px;
    border-radius: 7px;
    border: 1px solid var(--hair);
    overflow: hidden;
  }
  .strip span {
    flex: 1;
  }
  .tier {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 9px;
    border-radius: 999px;
    border: 1px solid var(--hair);
    font-size: 12.5px;
    color: var(--muted);
  }
  .end {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: auto;
  }
  .newer,
  .na {
    margin: 0;
    font-size: 13px;
  }
  .newer {
    color: var(--accent-text);
    font-weight: 500;
  }
  .na {
    color: var(--muted);
  }
  .foot {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--hair);
  }
  .marks {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .mark {
    display: inline-flex;
    color: var(--faint);
  }
  .mark svg {
    width: auto;
    height: 13px;
    fill: currentColor;
  }
  .verified {
    display: flex;
    flex: 1;
    justify-content: flex-end;
    gap: 1ch;
    min-width: 0;
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--faint);
  }
  .tool {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .keep {
    flex: none;
  }
</style>
